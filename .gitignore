*.db
*.sqlite
*.sqlite3

# --- Logs ---
*.log
logs/

# --- Environment / secrets ---
.env
.env.*
*.env

# --- IDE ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Project-specific ---
prompts.md
sample_logs/
